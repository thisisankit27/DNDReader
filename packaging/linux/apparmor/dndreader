# AppArmor profile for DNDReader (installed to /etc/apparmor.d/dndreader).
#
# This profile allows everything and exists only so the application is *named*
# and may create unprivileged user namespaces. Ubuntu 24.04+ sets
# kernel.apparmor_restrict_unprivileged_userns=1, which strips capabilities from
# user namespaces created by unconfined programs; without `userns` here the
# embedded browser's sandbox cannot start and DNDReader fails closed (the search
# panel is disabled and results open in the system browser).
#
# Same shape as the profiles Ubuntu ships for Chrome, Chromium, Signal, Slack.
#
# abi/4.0, not abi/5.0: `userns` rules (the only non-trivial thing this profile
# mediates) were introduced in AppArmor's abi/4.0, shipped with Ubuntu 24.04 —
# this is Ubuntu's own documented pattern for exactly this restriction. abi/5.0
# adds mediation classes (io_uring, extended capabilities, a more detailed
# userns_create grammar, …) that this profile uses none of; pinning to it buys
# nothing here and costs compatibility with every system that only has 4.0,
# which is every non-24.04-or-newer-at-the-time-of-this-file install plus, in
# practice, GitHub's ubuntu-latest CI runner (verified: it had no abi/5.0 at
# all, so apparmor_parser refused the profile outright and the sandbox could
# not start). abi/4.0 is confirmed present on Ubuntu 24.04 and 26.04.
abi <abi/4.0>,
include <tunables/global>

profile dndreader /usr/lib/dndreader/dndreader flags=(unconfined) {
  userns,
  @{exec_path} mr,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/dndreader>
}
